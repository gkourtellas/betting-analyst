# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Matchbook exchange login (primary odds source) ---
# Your normal Matchbook.com account credentials.
# Used only to call Matchbook's official login endpoint and get a session-token.
# Docs: https://developers.matchbook.com/reference/login
MATCHBOOK_USERNAME=""
MATCHBOOK_PASSWORD=""

# --- The Odds API (fallback, used only if Matchbook is not configured or returns nothing) ---
ODDS_API_KEY=""

# --- Telegram dispatch (optional) ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
